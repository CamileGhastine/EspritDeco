<div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cart-offcanvas" aria-labelledby="cart-offcanvasLabel">
  <div class="offcanvas-header">
    <h3 class="offcanvas-title" id="cart-offcanvasLabel">Mon panier</h3>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    {% if cartHandler.getCart.items | length == 0 %}
        <p>Votre panier est vide</p>
    {% else %}
        <table class="table table-hover">
            <tbody>
                {% for cartLine in cartHandler.getCart.items %}
                    <tr class="table-secondary">
                        <td>{{ cartLine.product.title }} ({{ cartLine.product.price }} €)</td>
                        <td>
                            <span class="badge rounded-pill bg-primary">-</span>
                            {{ cartLine.quantity}}
                            <span class="badge rounded-pill bg-primary">+</span>
                        </td>
                        <td>{{ cartLine.product.price * cartLine.quantity }} €</td>
                    </tr>                
                {% endfor %}
                <tr class="table-type">
                    <td>
                        <a href="{{ path('app_cart_clear')}}" class="text-decoration-none badge rounded-pill bg-primary">
                            Vider le panier
                        </a>
                    </td>
                    <td> TOTAL</td>
                    <td>{{ cartHandler.getCart.totalPrice }} €</td>
                </tr>
            </tbody>
        </table>
        <div class="text-end">
                <a class="btn btn-primary" href="#">Payer</a>
        </div>
    {% endif %}
  </div>
</div>