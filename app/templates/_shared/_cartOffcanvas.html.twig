{% set cart = cartHandler.getCart %}

<div class="offcanvas offcanvas-end cart-offcanvas" tabindex="-1" id="cart-offcanvas" aria-labelledby="cart-offcanvasLabel">
  <div class="offcanvas-header">
    <h3 class="offcanvas-title" id="cart-offcanvasLabel">Mon panier</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    {% if cart.totalPrice ==0 %}
        <p>Votre panier est vide</p>
    {% else %}
        <table class="table table-hover">
            <tbody>
                    {% for item in cart.items %}
                        <tr class="table-secondary" data-product-id="{{ item.product.id }}">
                            <td>{{ item.product.title }} ({{ item.product.price }} €)</td>
                            <td>
                                <span class="badge rounded-pill bg-primary pointer decrease-cart">-</span>
                                <span class="item-qty">{{ item.quantity }}</span>
                                <span class="badge rounded-pill bg-primary pointer increase-cart"
                                    data-url="{{ path('app_cart_increase', {id: item.product.id}) }}">+</span>
                            </td>
                            <td class="line-total">
                                {{ (item.product.price * item.quantity) | number_format(2, '.', ' ') }} €
                            </td>
                        </tr>            
                    {% endfor %}
                <tr class="table-type">
                    <td>
                        <span class="badge rounded-pill bg-primary pointer" 
                            id="clear-cart"
                            data-url="{{ path('app_cart_clear') }}">
                            Vider le panier
                        </span>
                    </td>
                    <td>TOTAL</td>
                    <td id="cart-total">
                        {{ (cart.totalPrice) | number_format(2, '.', ' ') }} €  
                    </td>
                </tr>
            </tbody>
        </table>
    <div class="text-end">
            <a class="btn btn-primary" href="#">Payer</a>
    </div>        
    {% endif %}
  </div>
</div>