{% extends 'base.html.twig' %}

{% block title %}Gestion des Produit{% endblock %}

{% block body %}
    <h1 class="text-center my-5">Gestion des produits</h1>
    <div class="text-center mb-4">
        <a href="{{ path('app_admin_product_save') }}" class="badge rounded-pill bg-primary text-decoration-none">
            ➕
        </a>
    </div>
    
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col" class="text-center">Titre</th>
                <th scope="col" class="text-center">Prix</th>
                <th scope="col" class="text-center">Catégorie</th>
                <th scope="col" class="text-center">Modifier</th>
                <th scope="col" class="text-center">Supprimer</th>
            </tr>
        </thead>
        <tbody>
            {% for i, product in products %}
                <tr class="table-{{ i%2 ? 'secondary' : 'light'}}">
                    <td class="text-center">
                        <a href="{{ path('app_product_show', {id: product.id}) }}" class="text-decoration-none">
                            {{ product.title }}
                        </a>
                    </td>
                    <td class="text-center">{{ product.price }} €</td>
                    <td class="text-center">{{ product.category.name }}</td>
                    <td class="text-center">✏️</td>
                    <td class="text-center">
                        <div class="pointer" data-bs-toggle="modal" data-bs-target="#deleteModal-{{ product.id}}">
                            ❌
                        </div>
                    </td>
                </tr>
                {% include '_shared/_deleteModal.html.twig' %}
            {% endfor %}
        </tbody>
    </table>
    <div class="text-center mb-5">
         <a href="{{ path('app_admin_panel') }}" class="btn btn-primary">
            Retour
        </a>
    </div>
{% endblock %}
