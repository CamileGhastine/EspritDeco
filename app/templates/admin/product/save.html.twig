{% extends 'base.html.twig' %}

{% block title %}Ajout d'un produit{% endblock %}

{% block body %}
    <h1 class="my-5 text-center">Ajouter un produit</h1>
    <div class="mb-5">
        {{ form_start(form)}}
        {{ form_widget(form)}}
        <button class="btn btn-primary">Enregistrer</button>
        {{ form_end(form)}}    
    </div>

    <div class="text-center mb-5">
         <a href="{{ app.request.headers.get('referer') ?? path('app_product_index') }}" class="btn btn-primary">
            Retour
        </a>
    </div>
{% endblock %}
