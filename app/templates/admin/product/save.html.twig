{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('admin-product-save') }}
    {{ importmap('save-css') }}
{% endblock %}

{% set action = isEdit ? 'Modifier' :' Enregistrer' %}

{% block title %} {{ action }} un produit{% endblock %}

{% block body %}
    <h1 class="my-5 text-center">{{ action }} un produit</h1>
    <div>
        {{ form_start(form)}}
        {{ form_row(form.title)}}
        {{ form_row(form.description)}}
        {{ form_row(form.price)}}
        {{ form_row(form.category)}}
        {{ form_row(form.images)}}
        <div id="extra-images"></div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="add-image-btn">
           ➕ Ajouter une image 
        </button>

        <div class="text-end">
            <button class="btn btn-primary">{{ action }}</button>
        </div>

        {{ form_end(form)}}    
    </div>
    {% if isEdit and product is defined and product.images is not empty %}
        <div class="d-flex flex-column align-items-center flex-md-row flex-wrap gap-3 mb-4">
            {% for image in product.images %}
                <div id="image-card-{{ image.id }}" class="card card-minotaur {{ image.isPrincipal ? 'border-primary border-3' : ''}}">
                    <img src="{{ asset(upload_image_path ~ '/' ~ image.name) }}" class="card-img-top" style="height: 100px; object-fit: cover;">
                    <div class="card-body p-1 text-center row">
                        <div class="col-6 text-center">
                            <span class="badge bg-primary mb-1 {{ image.isPrincipal ? '' : 'd-none' }}" id="badge-star-{{ image.id }}">
                                Principale
                            </span>   
                            <span type="button"
                                class="{{ image.isPrincipal ? 'd-none' : '' }}"
                                id="btn-star-{{ image.id }}"
                                data-url="{{ path('app_admin_image_principal', {id: image.id }) }}"
                                data-id="{{ image.id }}"
                                data-token="{{ csrf_token('principal-image-' ~ image.id) }}"
                                onclick="setPrincipal(this)">
                                ⭐
                            </span>                                                    
                        </div>
                        <div class="col-6 text-center">
                            <span type="button"
                                id="btn-delete-{{ image.id }}"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal-{{ image.id}}"
                                class="{{ image.isPrincipal ? 'd-none' : '' }}">
                                ❌
                            </span>
                        </div>
                    </div>
                </div>
                {% include '_shared/_deleteImageModal.html.twig' %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="text-center mb-5">
         <a href="{{ app.request.headers.get('referer') ?? path('app_product_index') }}" class="btn btn-primary">
            Retour
        </a>
    </div>
{% endblock %}
