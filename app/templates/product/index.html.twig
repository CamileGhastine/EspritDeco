{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('card-css') }}
{% endblock %}

{% block title %}Esprit Déco : Accueil{% endblock %}

{% block body %}
    <div class="row my-5">
        {% for product in products %}
            <div class="col-12 col-md-6 col-lg-3  my-2">
                <div class="card h-100 ">
                    <h2 class="card-header text-center">
                        <a href="{{ path('app_product_show', {id: product.id})}}" class="text-white text-decoration-none">
                            {{ product.title }}
                        </a>
                    </h2>
                    {% if product.images is not empty and product.images[0] is defined %}
                        <img src="{{ product.images[0].path }}" alt="{{ product.images[0].alt }}">
                    {% else %}
                        <div class="no-image bg-light">🚫</div>
                    {% endif %}
                    <div class="card-body">
                        <p class="card-text">{{ product.description | split(' ')|slice(0, 20)|join(' ') ~ ' ...' }} </p>
                    </div>
                    <div class="card-footer text-muted text-end">
                        <div class="row">
                            <div class="col-12 col-md-6 text-center text-lg-start">{{ product.category.name }}</div>
                            <div class="col-12 col-md-6 text-center badge rounded-pill bg-primary">{{ product.price }} €</div>                
                        </div>
                    </div>
                </div>   
            </div>
        {% endfor %}      
    </div>
{% endblock %}
