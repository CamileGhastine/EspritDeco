{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('card-css') }}
    {{ importmap('save-css') }}
{% endblock %}

{% block title %}Esprit Déco : {{ product.title }}{% endblock %}

{% block body %}
    <div class="row my-5">
        <div class="card">
            <div class="card-header text-center my-4">
                <h1 >
                    <a href="{{ path('app_product_show', {id: product.id})}}" class="text-white text-decoration-none">
                        {{ product.title }}
                    </a>           
                </h1>
                <div class="d-flex flex-column align-items-center">
                    <hr class="w-50">
                    <div>{{ product.category.name }}</div>
                </div>
            </div>

            {% if product.images is not empty %}
                <div id="carouselExample" class="carousel slide my-4">
                    <div class="carousel-inner">
                        {% for image in product.images %}
                            <div class="carousel-item {{ image.isPrincipal ? 'active' : '' }}">
                                <div class="d-flex justify-content-center align-items-center h-100">     
                                    <img src="{{ upload_image_path ~ '/' ~ asset(image.name) }}" alt="{{ image.alt }}" class="d-block img-fluid carousel-image mx-auto">
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {% if product.images | length > 1 %}
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>            
                    {% endif %}
                </div>
            {% else %}
                <div class="no-image bg-light">🚫</div>
            {% endif %}
            
            <div class="card-body">
                <p class="card-text">{{ product.description }} </p>
            </div>
            
            <div class="card-footer text-muted text-end my-4">
                <div class="row">
                    <div class="col-12 col-md-6 d-flex justify-content-center align-items-center my-2 my-md-0">
                        <div class="badge rounded-pill bg-primary w-50 text-center py-3">
                            {{ product.price }} €
                        </div>
                    </div>     
                    <div class="col-12 col-md-6 d-flex justify-content-center my-2 my-md-0">
                        <a href="{{ path('app_cart_add', {id: product.id})}}"
                            class="btn btn-secondary w-50 text-center py-3 badge rounded-pill bg-secondary border-primary border-5 w-50 text-center py-3">
                            Ajouter au panier
                        </a>
                    </div>                
                </div>
            </div>
        </div>   
    </div>
    <div class="text-center mb-5">
         <a href="{{ app.request.headers.get('referer') ?? path('app_product_index') }}" class="btn btn-primary">
            Retour
        </a>
    </div>
   
{% endblock %}
